{
  "manifest_version": 3,
  "name": "Job Tracker",
  "version": "1.0.0",
  "description": "Track job applications locally. Auto-fill from job sites, manage status, export to Excel. Privacy-focused.",
  "action": {
    "default_title": "Job Tracker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://www.indeed.co.uk/*",
    "https://www.indeed.de/*",
    "https://www.indeed.ie/*",
    "https://www.totaljobs.com/*",
    "https://www.reed.co.uk/*",
    "https://www.cwjobs.co.uk/*",
    "https://www.jobsite.co.uk/*",
    "https://www.fish4.co.uk/*",
    "https://www.adzuna.co.uk/*",
    "https://www.stepstone.de/*",
    "https://www.monster.de/*",
    "https://www.monster.ie/*",
    "https://www.xing.com/*",
    "https://ec.europa.eu/*",
    "https://www.jobware.de/*",
    "https://www.karriere.de/*",
    "https://www.jobsintown.de/*",
    "https://www.careerjet.ie/*",
    "https://www.jobsireland.ie/*",
    "https://www.recruitireland.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://www.indeed.com/*",
        "https://www.indeed.co.uk/*",
        "https://www.indeed.de/*",
        "https://www.indeed.ie/*",
        "https://www.totaljobs.com/*",
        "https://www.reed.co.uk/*",
        "https://www.cwjobs.co.uk/*",
        "https://www.jobsite.co.uk/*",
        "https://www.fish4.co.uk/*",
        "https://www.adzuna.co.uk/*",
        "https://www.stepstone.de/*",
        "https://www.monster.de/*",
        "https://www.monster.ie/*",
        "https://www.xing.com/*",
        "https://ec.europa.eu/*",
        "https://www.jobware.de/*",
        "https://www.karriere.de/*",
        "https://www.jobsintown.de/*",
        "https://www.careerjet.ie/*",
        "https://www.jobsireland.ie/*",
        "https://www.recruitireland.com/*"
      ],
      "js": [
        "content/site-parsers.js",
        "content/content.js"
      ],
      "run_at": "document_end"
    }
  ]
}